# Copia este archivo como .env y ajusta si hace falta
OLLAMA_BASE_URL=http://localhost:11434
ECIGUIA_LLM=qwen2.5:7b
ECIGUIA_EMBED=bge-m3
ECIGUIA_CHUNKING=articulo
ECIGUIA_TOP_K=4
# Distancia coseno máxima para aceptar un fragmento. Calibrada con eval/calibrate.py (docs/resultados/calibracion.png)
ECIGUIA_MAX_DISTANCE=0.45
# 1 = embeber las preguntas en CPU para dejar la GPU al LLM (recomendado con GPUs de 6 GB o menos)
ECIGUIA_EMBED_QUERY_ON_CPU=1
# Segundos que Ollama mantiene los modelos cargados entre preguntas
ECIGUIA_KEEP_ALIVE=1800
